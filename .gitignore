# Godot 4.2+ specific ignores
~*.dll

# Godot 4+ specific ignores
.godot/
.nomedia

# Godot-specific ignores
.import/
export.cfg
export_credentials.cfg
*.tmp

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# Export outputs
*.exe
# Uncomment if your project does not version PCK files as runtime dependencies.
# *.pck

# Voice: the Linux build of the speech addon is only used for testing (the game targets Windows)
addons/godot_whisper/bin/*.so
# Bigger optional voice models (download them yourself, see VOICE_SETUP.md)
models/ggml-base*.bin
models/ggml-small*.bin
!translations/*.translation
__pycache__/
