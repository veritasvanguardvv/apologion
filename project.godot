; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Apologion personal copy prototype?"
run/main_scene="uid://yobqlpxvpfqj"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"
config/name.ios="Apologion"
config/name.web="Apologion"
config/name.es_edition="(Es) Apologion"
run/main_scene.es_edition="res://Greed.tscn"
run/main_scene.web_greed="res://Greed.tscn"
config/name.web_greed="Apologion"
boot_splash/bg_color=Color(0.07, 0.07, 0.1, 1)
boot_splash/image="res://icons/splash_sheep.png"
boot_splash/stretch_mode=0
boot_splash/use_filter=false

[audio]

driver/enable_input=true
general/text_to_speech=true
general/ios/session_category=3
input/transcribe/use_gpu=false

[autoload]

GameSettings="*res://settings_manager.gd"
VerseManager="*res://verse_manager.gd"
SaveManager="*res://save_manager.gd"
TurnManager="*res://turn_manager.gd"
PartyManager="*res://party_manager.gd"
SpeechRecognizer="*res://speech_recognizer.gd"
Targeting="*res://targeting.gd"
Inventory="*res://inventory.gd"
PhoneServer="*res://phone_server.gd"
OnlineService="*res://online_service.gd"
TouchControls="*res://touch_controls.gd"
BabyMode="*res://baby_mode.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"
window/handheld/orientation=4
window/stretch/scale_mode.mobile="fractional"
window/stretch/scale_mode.web="fractional"

